# {{ ansible_managed }}
[Unit]
Description=Prometheus exporter for Asterisk (AMI)
Documentation=https://github.com/ErenOzgu/asterisk-exporter
After=network-online.target asterisk.service
Wants=network-online.target

[Service]
EnvironmentFile=/etc/asterisk-exporter.env
# The exporter runs on the PBX itself, so Asterisk's local time zone is its own.
ExecStart=/usr/local/bin/asterisk-exporter \
  -web.listen-address={{ monitoring_listen_address }}:{{ pbx_exporter_port }} \
  -ami.address=127.0.0.1:5038 \
  -collect.confbridge={{ monitoring_exporter_confbridge | lower }}
Restart=on-failure
RestartSec=5

DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallFilter=@system-service
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
