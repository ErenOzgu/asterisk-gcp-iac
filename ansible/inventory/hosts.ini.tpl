# Generated by scripts/make-inventory.sh: reaches the VM through an IAP tunnel.
[asterisk]
@NAME@ ansible_user=@OS_LOGIN_USER@ ansible_ssh_private_key_file=~/.ssh/google_compute_engine ansible_ssh_common_args='-o ProxyCommand="gcloud compute start-iap-tunnel @NAME@ 22 --listen-on-stdin --zone=@ZONE@ --project=@PROJECT@" -o StrictHostKeyChecking=accept-new -o HostKeyAlias=@NAME@.@PROJECT@'

