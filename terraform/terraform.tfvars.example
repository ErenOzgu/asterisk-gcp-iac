project_id = "my-voip-project"

# Required: who may talk SIP to the PBX. Use your trunk provider's addresses and
# your office/VPN egress. There is no default on purpose.
sip_source_ranges = ["203.0.113.10/32", "198.51.100.0/24"]

# Optional. Defaults to the SIP ranges.
# rtp_source_ranges = ["203.0.113.0/24"]

# Optional. Your Prometheus server(s).
# monitoring_source_ranges = ["10.20.0.5/32"]

# People allowed to SSH in through IAP.
admin_members = ["user:you@example.com"]
